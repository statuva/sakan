rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function memberPath(familyId, memberId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(memberId);
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && exists(memberPath(familyId, request.auth.uid))
        && get(memberPath(familyId, request.auth.uid)).data.isActive == true;
    }

    function memberRole(familyId) {
      return get(memberPath(familyId, request.auth.uid)).data.role;
    }

    function isFamilyAdmin(familyId) {
      return isFamilyMember(familyId)
        && memberRole(familyId) == 'admin';
    }

    function isAdultOrAdmin(familyId) {
      return isFamilyMember(familyId)
        && (
          memberRole(familyId) == 'admin'
          || memberRole(familyId) == 'adult'
        );
    }

    function isAiAdult(familyId) {
      return isAdultOrAdmin(familyId)
        && get(memberPath(familyId, request.auth.uid)).data.ageGroup in [
          'adult',
          'senior'
        ];
    }

    function validRoleAge(data) {
      return data.role == 'child'
        || (
          data.role in ['admin', 'adult']
          && data.ageGroup in ['adult', 'senior']
        );
    }

    function familyAfter(familyId) {
      return getAfter(familyPath(familyId));
    }

    function validInvitation(code, familyId) {
      return exists(invitationPath(code))
        && exists(familyPath(familyId))
        && get(invitationPath(code)).data.familyId == familyId
        && get(invitationPath(code)).data.isActive == true
        && get(invitationPath(code)).data.expiresAt > request.time;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId;

      allow read, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /invitations/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && familyAfter(
          request.resource.data.familyId
        ).data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && isFamilyAdmin(resource.data.familyId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'isActive',
            'expiresAt'
          ]);

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && isFamilyAdmin(resource.data.familyId);
    }

    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if isFamilyMember(familyId)
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow update, delete: if isFamilyAdmin(familyId);

      match /members/{memberId} {
        allow get: if signedIn()
          && (
            memberId == request.auth.uid
            || isFamilyMember(familyId)
          );

        allow list: if isFamilyMember(familyId);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.resource.data.isActive == true
          && validRoleAge(request.resource.data)
          && (
            (
              request.resource.data.role == 'admin'
              && familyAfter(familyId).data.createdBy == request.auth.uid
            )
            ||
            (
              request.resource.data.role == 'child'
              && request.resource.data.joinedViaInviteCode is string
              && validInvitation(
                request.resource.data.joinedViaInviteCode,
                familyId
              )
            )
          );

        allow update: if validRoleAge(request.resource.data)
          && (
            isFamilyAdmin(familyId)
            || (
            signedIn()
            && memberId == request.auth.uid
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'displayName',
                'photoUrl',
                'ageGroup',
                'interests',
                'preferredDays',
                'preferredStartMinutes',
                'preferredEndMinutes',
                'notificationPreferences',
                'privacyConsent',
                'updatedAt'
              ])
            )
          );

        allow delete: if isFamilyAdmin(familyId);

        match /scheduleBlocks/{blockId} {
          allow read: if isFamilyMember(familyId)
            && memberId == request.auth.uid;

          allow create: if isFamilyMember(familyId)
            && memberId == request.auth.uid
            && request.resource.data.familyId == familyId
            && request.resource.data.memberId == request.auth.uid;

          allow update: if isFamilyMember(familyId)
            && memberId == request.auth.uid
            && resource.data.memberId == request.auth.uid
            && request.resource.data.memberId == request.auth.uid
            && request.resource.data.familyId == familyId;

          allow delete: if isFamilyMember(familyId)
            && memberId == request.auth.uid
            && resource.data.memberId == request.auth.uid;
        }
      }

      match /availabilityBlocks/{blockId} {
        allow read: if isFamilyMember(familyId);

        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.memberId == request.auth.uid;

        allow update: if isFamilyMember(familyId)
          && resource.data.memberId == request.auth.uid
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.memberId == resource.data.memberId;

        allow delete: if isFamilyMember(familyId)
          && resource.data.memberId == request.auth.uid;
      }

      match /moments/{momentId} {
        allow read: if isFamilyMember(familyId);

        allow create: if isAdultOrAdmin(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isAdultOrAdmin(familyId);
      }

      match /momentInstances/{instanceId} {
  allow read: if isFamilyMember(familyId);

  allow create: if isAdultOrAdmin(familyId)
    && request.resource.data.familyId == familyId
    && request.resource.data.momentId is string
    && request.resource.data.titleSnapshot is string
    && request.resource.data.expectedParticipantIds is list
    && request.resource.data.confirmedParticipantIds is list
    && request.resource.data.reportedParticipantIds is list
    && request.resource.data.evidenceSignals is list
    && request.resource.data.scheduledStartAt is timestamp
    && request.resource.data.createdBy == request.auth.uid
    && (
      request.resource.data.status in [
        'proposed',
        'scheduled',
        'inviting',
        'active'
      ]
      ||
      (
        request.resource.data.status == 'completed'
        && request.resource.data.source in [
          'spontaneous',
          'todayReview'
        ]
        && request.resource.data.reviewedBy
          == request.auth.uid
      )
    );

  allow update: if isAdultOrAdmin(familyId)
    && request.resource.data.familyId
      == resource.data.familyId
    && request.resource.data.momentId
      == resource.data.momentId
    && request.resource.data.createdBy
      == resource.data.createdBy
    && request.resource.data.status in [
      'proposed',
      'scheduled',
      'inviting',
      'active',
      'completed',
      'missed',
      'cancelled'
    ];

  allow delete: if isFamilyAdmin(familyId);

   match /participants/{memberId} {
    allow read: if isFamilyMember(familyId);

    allow create: if isFamilyMember(familyId)
      && memberId == request.auth.uid
      && request.resource.data.familyId == familyId
      && request.resource.data.instanceId == instanceId
      && request.resource.data.memberId == request.auth.uid
      && request.resource.data.state in [
        'invited',
        'ready',
        'nearby',
        'checkedIn',
        'declined',
        'left'
      ];

    allow update: if (
      isFamilyMember(familyId)
      && memberId == request.auth.uid
      && resource.data.memberId == request.auth.uid
      && request.resource.data.memberId
        == resource.data.memberId
      && request.resource.data.familyId
        == resource.data.familyId
      && request.resource.data.instanceId
        == resource.data.instanceId
      && request.resource.data.state in [
        'invited',
        'ready',
        'nearby',
        'checkedIn',
        'declined',
        'left'
      ]
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'state',
          'checkInMethod',
          'checkedInAt',
          'checkedOutAt',
          'nearbyDetectedAt',
          'confirmedAt',
          'updatedAt'
        ])
    ) || (
      isAdultOrAdmin(familyId)
      && resource.data.state == 'ready'
      && request.resource.data.state in [
        'invited',
        'nearby'
      ]
      && request.resource.data.memberId
        == resource.data.memberId
      && request.resource.data.familyId
        == resource.data.familyId
      && request.resource.data.instanceId
        == resource.data.instanceId
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'state',
          'updatedAt'
        ])
    );

    allow delete: if isFamilyAdmin(familyId)
      || (
        isFamilyMember(familyId)
        && memberId == request.auth.uid
      );
  }

}

match /dailyReviews/{reviewId} {
  allow read: if isFamilyMember(familyId);

  allow create: if isAdultOrAdmin(familyId)
    && request.resource.data.familyId == familyId
    && request.resource.data.reviewedBy == request.auth.uid
    && request.resource.data.dateKey is string
    && request.resource.data.reviewDate is timestamp
    && request.resource.data.resolvedInstanceIds is list
    && request.resource.data.loggedInstanceIds is list;

  allow update: if isAdultOrAdmin(familyId)
    && request.resource.data.familyId == resource.data.familyId
    && request.resource.data.reviewedBy == request.auth.uid
    && request.resource.data.dateKey == resource.data.dateKey
    && request.resource.data.reviewDate == resource.data.reviewDate;

  allow delete: if isFamilyAdmin(familyId);
}



      match /careActions/{actionId} {
  // Adults/admins may access family Care Actions.
  //
  // Other members may access only reminders
  // assigned to their own account.
  allow read: if isAdultOrAdmin(familyId)
    || (
      isFamilyMember(familyId)
      && resource.data.assignedMemberId
        == request.auth.uid
    );

  // Adults/admins may assign family actions.
  //
  // Any family member may create a personal
  // reminder assigned only to themselves.
  allow create: if isFamilyMember(familyId)
    && request.resource.data.familyId
      == familyId
    && request.resource.data.title is string
    && request.resource.data.dueAt is timestamp
    && request.resource.data.assignedMemberId
      is string
    && (
      isAdultOrAdmin(familyId)
      || request.resource.data.assignedMemberId
        == request.auth.uid
    );

  // Adults/admins may manage family actions.
  //
  // Assigned users may edit their own reminder
  // text, date, status, and completion state.
  allow update: if isAdultOrAdmin(familyId)
    || (
      isFamilyMember(familyId)
      && resource.data.assignedMemberId
        == request.auth.uid
      && request.resource.data.familyId
        == resource.data.familyId
      && request.resource.data.assignedMemberId
        == resource.data.assignedMemberId

      // Existing source and Moment links cannot
      // be changed after they have been stored.
      && request.resource.data.get('source', null)
        == resource.data.get('source', null)
      && request.resource.data.get('momentId', null)
        == resource.data.get('momentId', null)
      && request.resource.data.get('instanceId', null)
        == resource.data.get('instanceId', null)

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'title',
          'reason',
          'dueAt',
          'status',
          'source',
          'momentId',
          'instanceId',
          'evidenceType',
          'completedAt',
          'updatedAt'
        ])
    );

  allow delete: if isAdultOrAdmin(familyId)
    || (
      isFamilyMember(familyId)
      && resource.data.assignedMemberId
        == request.auth.uid
    );
}

      match /rhythms/{rhythmId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isAdultOrAdmin(familyId);
        allow delete: if isFamilyAdmin(familyId);
      }

      match /memories/{memoryId} {
        allow read: if isFamilyMember(familyId);

        allow create: if isAdultOrAdmin(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.get('aiReflection', null) == null;

        allow update: if isAdultOrAdmin(familyId)
          && (
            request.resource.data.get('aiReflection', null)
              == resource.data.get('aiReflection', null)
            || request.resource.data.get('aiReflection', null) == null
          );

        allow delete: if isAdultOrAdmin(familyId);
      }

      match /aiArtifacts/{artifactId} {
        allow read: if isAiAdult(familyId)
          && (
            resource.data.audience == 'family-adults'
            || resource.data.audience == request.auth.uid
          );
        allow write: if false;
      }

      match /weeklyReports/{reportId} {
        allow read: if isAiAdult(familyId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
